# Grafana settings as environment variables. deploy-monitoring.sh fills in the double-underscore placeholders below.
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=__GRAFANA_PORT__
GF_SERVER_DOMAIN=__GRAFANA_HOST__
GF_SERVER_ROOT_URL=https://__GRAFANA_HOST__/
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_PATHS_DATA=/var/lib/grafana
GF_PATHS_PLUGINS=/var/lib/grafana/plugins
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
GF_LOG_MODE=console
GF_METRICS_ENABLED=false

          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000000000.0
              },
              {
                "color": "green",
                "value": 10000000000.0
              }
            ]
          }
        },
        "overrides": []

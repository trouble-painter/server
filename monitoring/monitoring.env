# Settings shared by the monitoring files and the deploy scripts. Plain KEY=VALUE, no secrets.
# Everything listens on loopback except Grafana, which cloudflared publishes at GRAFANA_HOST.
GRAFANA_HOST=trouble-painter-dashboard.devstory.co.kr
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
PROMETHEUS_VERSION=3.15.1
NODE_EXPORTER_VERSION=1.12.1
GRAFANA_VERSION=13.3.1

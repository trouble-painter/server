# deploy-monitoring.sh installs this into /etc/systemd/system/. Fix it here and deploy again.
[Unit]
Description=Prometheus node exporter
After=network-online.target
Wants=network-online.target

[Service]
User=node_exporter
ExecStart=/opt/monitoring/node_exporter/node_exporter --web.listen-address=127.0.0.1:__NODE_EXPORTER_PORT__
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
